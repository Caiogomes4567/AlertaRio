# Configure estas variáveis em: Vercel > Project > Settings > Environment Variables
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=chave_service_role_do_supabase
DEVICE_API_KEY=troque_por_uma_chave_longa_e_aleatoria
# opcional: minutos sem leitura para considerar a estação offline (padrão 10)
OFFLINE_AFTER_MIN=10
