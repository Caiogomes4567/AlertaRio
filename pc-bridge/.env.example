# Copie para .env e ajuste
# URL do seu site na Vercel (sem barra no final)
SITE_URL=https://SEU-SITE.vercel.app
# Mesma chave configurada em DEVICE_API_KEY na Vercel
DEVICE_API_KEY=troque_por_uma_chave_longa_e_aleatoria
# Porta serial do ESP32. Windows: COM3 | Linux: /dev/ttyUSB0 | macOS: /dev/cu.usbserial-XXXX
# Deixe vazio para tentar detectar sozinho
SERIAL_PORT=
BAUD_RATE=115200
# Envia ao site no máximo 1 leitura a cada N segundos...
SEND_INTERVAL_S=60
# ...ou imediatamente se o nível mudar pelo menos N cm desde o último envio
CHANGE_CM=10
